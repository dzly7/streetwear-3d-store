# ==============================================================================
# SYNICAL™ E-COMMERCE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copia este archivo como .env y coloca tus credenciales reales

# 1. SUPABASE (Base de datos PostgreSQL e inventario en tiempo real)
# Obtén estas credenciales gratis en: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica
SUPABASE_SERVICE_ROLE_KEY=tu-clave-secreta-service-role

# 2. STRIPE (Pasarela de Pagos con Tarjeta, Apple Pay y Google Pay)
# Obtén tus claves en modo test en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_de_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_clave_webhook_stripe

# 3. CONFIGURACIÓN DEL SERVIDOR Y SEGURIDAD ADMIN
PORT=3001
CLIENT_URL=http://localhost:5173
VITE_ADMIN_PIN=SYNICAL2026
